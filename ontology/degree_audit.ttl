############################################################
# SWRL rules (R1-R4)
############################################################

da:RuleR1 a swrl:Imp ;
    rdfs:label "R1: passed enrollment means completed course" ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:argument1 da:r1_s ;
          swrl:classPredicate da:Student ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r1_s ;
          swrl:argument2 da:r1_e ;
          swrl:propertyPredicate da:hasEnrollment ]
        [ a swrl:DatavaluedPropertyAtom ;
          swrl:argument1 da:r1_e ;
          swrl:argument2 true ;
          swrl:propertyPredicate da:passed ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r1_e ;
          swrl:argument2 da:r1_c ;
          swrl:propertyPredicate da:forCourse ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r1_s ;
          swrl:argument2 da:r1_c ;
          swrl:propertyPredicate da:hasCompleted ]
    ) .

da:RuleR2 a swrl:Imp ;
    rdfs:label "R2: failed enrollment means course must be retaken" ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:argument1 da:r2_s ;
          swrl:classPredicate da:Student ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r2_s ;
          swrl:argument2 da:r2_e ;
          swrl:propertyPredicate da:hasEnrollment ]
        [ a swrl:DatavaluedPropertyAtom ;
          swrl:argument1 da:r2_e ;
          swrl:argument2 false ;
          swrl:propertyPredicate da:passed ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r2_e ;
          swrl:argument2 da:r2_c ;
          swrl:propertyPredicate da:forCourse ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r2_s ;
          swrl:argument2 da:r2_c ;
          swrl:propertyPredicate da:mustRetake ]
    ) .

da:RuleR3 a swrl:Imp ;
    rdfs:label "R3: probation student needs an advisor meeting" ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:argument1 da:r3_s ;
          swrl:classPredicate da:ProbationStudent ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r3_s ;
          swrl:argument2 da:r3_a ;
          swrl:propertyPredicate da:hasAdvisor ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r3_s ;
          swrl:argument2 da:r3_a ;
          swrl:propertyPredicate da:needsAdvisorMeeting ]
    ) .

da:RuleR4 a swrl:Imp ;
    rdfs:label "R4: student is affiliated with the advisor's department" ;
    swrl:body (
        [ a swrl:ClassAtom ;
          swrl:argument1 da:r4_s ;
          swrl:classPredicate da:Student ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r4_s ;
          swrl:argument2 da:r4_a ;
          swrl:propertyPredicate da:hasAdvisor ]
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r4_a ;
          swrl:argument2 da:r4_d ;
          swrl:propertyPredicate da:worksIn ]
    ) ;
    swrl:head (
        [ a swrl:IndividualPropertyAtom ;
          swrl:argument1 da:r4_s ;
          swrl:argument2 da:r4_d ;
          swrl:propertyPredicate da:affiliatedWith ]
    ) .

da:r1_s a swrl:Variable . da:r1_e a swrl:Variable . da:r1_c a swrl:Variable .
da:r2_s a swrl:Variable . da:r2_e a swrl:Variable . da:r2_c a swrl:Variable .
da:r3_s a swrl:Variable . da:r3_a a swrl:Variable .
da:r4_s a swrl:Variable . da:r4_a a swrl:Variable . da:r4_d a swrl:Variable .
