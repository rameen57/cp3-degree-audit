  <rdf:Description rdf:about="http://example.org/ontologies/degree-audit">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Ontology"/>
    <rdfs:label>University Degree Audit and Compliance Ontology</rdfs:label>
    <rdfs:comment>Models degree progress, prerequisites and academic standing for a BS Artificial Intelligence program. Course data is illustrative sample data.</rdfs:comment>
    <owl:versionInfo>1.0</owl:versionInfo>
  </rdf:Description>
